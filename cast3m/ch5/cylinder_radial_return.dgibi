*
* Thick-walled cylinder under internal pressure: radial return and
* equilibrium iterations programmed with fields in gibiane
* Chapter 5: "The thick-walled cylinder by finite elements" and
* "Consistent against continuum tangent" (Box 5.6; exercise "The
* radial return on fields in Cast3M" (b))
*
* STATUS: UNTESTED. Written against the operator notices; not run.
* See cast3m/README.md for the constructions to check first.
*
* a = 100, b = 200 mm, plane strain, E = 200 GPa, nu = 0.3,
* sY = 250 MPa. Reference values (python/examples/ch5, Newton
* with the consistent tangent, 200 linear elements, 20 steps):
*   pL = 200.0944 MPa
*   0.8 pL : u(a) = 0.18305 mm, c = 131.00 mm (closed form 130.77)
*   0.95 pL: u(a) = 0.30536 mm, c = 165.50 mm (closed form 164.00)
*   Voce (sinf = 600 MPa, delta = 30), p = 320 MPa in 10 steps,
*   80 elements: u(a) = 3.4526 mm, 47 Newton iterations.
*
* The local stage is the procedure rrj2 (same as return_map_point
* .dgibi). The global stage keeps the elastic stiffness KK, built
* and factorised once: this is the initial-strain iteration of
* Box 6.1, linear convergence, against Newton's quadratic one.
*
* Units: mm, MPa.  andrei.constantinescu@polytechnique.edu
*
*----------------------------------------------------------------
* PROCEDURE smul: product of a scalar field cc (component SCAL)
*   by every component of the field x named in the list lcp
*----------------------------------------------------------------
debproc smul cc*mchaml x*mchaml lcp*listmots;
  repeter bsm (dime lcp);
    nm = extr lcp &bsm;
    yi = exco (cc * (exco x nm 'SCAL')) 'SCAL' nm;
    si (&bsm ega 1);
      y = yi;
    sinon;
      y = y et yi;
    finsi;
  fin bsm;
finproc y;
*
*----------------------------------------------------------------
* PROCEDURE devia: deviator of a symmetric tensor field x;
*   ldia: names of the diagonal components (3 of them, also in
*   2D: SMZZ or SMTT), loff: names of the off-diagonal ones
*----------------------------------------------------------------
debproc devia x*mchaml ldia*listmots loff*listmots;
  nd = dime ldia;
  repeter bd1 nd;
    nm = extr ldia &bd1;
    si (&bd1 ega 1);
      tr = exco x nm 'SCAL';
    sinon;
      tr = tr + (exco x nm 'SCAL');
    finsi;
  fin bd1;
  pm = (1. / 3.) * tr;
  repeter bd2 nd;
    nm = extr ldia &bd2;
    di = exco ((exco x nm 'SCAL') - pm) 'SCAL' nm;
    si (&bd2 ega 1);
      y = di;
    sinon;
      y = y et di;
    finsi;
  fin bd2;
  repeter bd3 (dime loff);
    nm = extr loff &bd3;
    y = y et (exco x nm);
  fin bd3;
finproc y;
*
*----------------------------------------------------------------
* PROCEDURE hard: isotropic hardening R(alpha) and R'(alpha)
*   tm . 'LOI' = 'LINE': R = sY + K alpha
*   tm . 'LOI' = 'VOCE': R = sinf - (sinf - sY) exp(-delta alpha)
*   un: field of ones on the same Gauss points
*----------------------------------------------------------------
debproc hard al*mchaml un*mchaml tm*table;
  sy = tm . 'SIGY';
  si ((tm . 'LOI') ega 'VOCE');
    sinf = tm . 'SINF';
    del  = tm . 'DELT';
    ee = exp ((-1. * del) * al);
    rr = (sinf * un) - ((sinf - sy) * ee);
    rp = (del * (sinf - sy)) * ee;
  sinon;
    kk = tm . 'K';
    rr = (sy * un) + (kk * al);
    rp = kk * un;
  finsi;
finproc rr rp;
*
*----------------------------------------------------------------
* PROCEDURE rrj2: radial return of Box 5.2 at all Gauss points
*   input : model mo, trial stress sigtr = sig_n + C:(eps - eps_n),
*           back stress bet_n, cumulated plastic strain al_n,
*           table tm of material data (MU, H, SIGY, LOI, K or
*           SINF and DELT, DIAG, OFFD; optional ETA and DT for
*           the Perzyna update of Section 5.7)
*   output: sigma, beta, alpha at t_n+1, the increment dp of
*           alpha (component SCAL) and the trial function ftr
*   In the variables of Box 5.2, dp = sqrt(2/3) Delta gamma and
*   q = sqrt(3/2) |dev(sigma - beta)|; the scalar equation
*     q_tr - (3 mu + H + 3/2 eta/dt) dp - R(alpha_n + dp) = 0
*   is solved by Newton at every plastic Gauss point at once.
*----------------------------------------------------------------
debproc rrj2 mo*mmodel sigtr*mchaml bet*mchaml al*mchaml
             tm*table;
  mu = tm . 'MU';
  hh = tm . 'H';
  sy = tm . 'SIGY';
  ldia = tm . 'DIAG';
  loff = tm . 'OFFD';
  lcp  = ldia et loff;
  visc = 0.;
  si (exis tm 'ETA');
    visc = 1.5 * ((tm . 'ETA') / (tm . 'DT'));
  finsi;
  a3 = (3. * mu) + hh + visc;
* relative stress, von Mises norm of its deviator (SCAL)
  eta = sigtr - bet;
  qtr = vmis mo eta;
* un: ones; pla: 1 at the Gauss points where f_trial > 0
  un  = masq qtr 'SUPERIEUR' -1.;
  rr0 rp0 = hard al un tm;
  ftr = qtr - rr0;
  pla = masq ftr 'SUPERIEUR' 0.;
* local Newton from dp = 0 (one iteration for linear hardening,
* monotone convergence for Voce, Box 5.2 step 4)
  dp = 0. * un;
  repeter bnw 30;
    rr rp = hard (al + dp) un tm;
    gg = pla * (qtr - (a3 * dp) - rr);
    si ((maxi (abs gg)) < (1.e-10 * sy));
      quitter bnw;
    finsi;
    dp = dp + (gg / ((a3 * un) + rp));
    si (&bnw ega 30);
      mess 'rrj2: local Newton not converged, max |g| = '
           (maxi (abs gg));
    finsi;
  fin bnw;
* update along the radial direction n = eta_dev / |eta_dev|:
*   sigma = sigma_tr - 3 mu dp eta_dev / q
*   beta  = beta_n   + H    dp eta_dev / q
* (qs: q shifted by 1e-12 sY to avoid 0/0 where dp = 0)
  qs  = qtr + ((1.e-12 * sy) * un);
  ed  = devia eta ldia loff;
  sig = sigtr - (smul ((3. * mu) * (dp / qs)) ed lcp);
  bet2 = bet + (smul (hh * (dp / qs)) ed lcp);
  al2  = al + dp;
finproc sig bet2 al2 dp ftr;
*
*----------------------------------------------------------------
* PROCEDURE incr: one load path computed by hand (Box 5.3 with the
*   elastic stiffness as iteration matrix, i.e. Box 6.1).
*   lp: list of pressures p_1 < ... < p_N; tm: material table.
*   Returns the state table st (U, SIG, BET, ALP) and the total
*   number of equilibrium iterations.
*----------------------------------------------------------------
debproc incr dom*maillage mo*mmodel ma*mchaml kk*rigidite
             aa*rigidite fp*chpoint lp*listreel tm*table
             tol*flottant;
  lfor = mots 'FR' 'FZ';
  st = table;
  s0 = zero mo 'CONTRAIN';
  st . 'SIG' = s0;
  st . 'BET' = s0;
  st . 'ALP' = 0. * (masq (vmis mo s0) 'SUPERIEUR' -1.);
  uu = manu 'CHPO' dom 2 'UR' 0. 'UZ' 0.;
  st . 'U' = uu;
  fo = 0. * fp;
  nit = 0;
  repeter bpas (dime lp);
    ff = (extr lp &bpas) * fp;
*   converged state of t_n: the return map always starts from it
    un = st . 'U';
    sn = st . 'SIG';
    bn = st . 'BET';
    an = st . 'ALP';
*   predictor: elastic response to the load increment
    uu = un + (reso (kk et aa) (ff - fo));
    repeter bequ 2000;
      nit = nit + 1;
*     local stage: radial return from z_n at every Gauss point
      sgt = sn + (sigm mo ma (uu - un));
      s b a dp ft = rrj2 mo sgt bn an tm;
*     global stage: residual, constraints included as in the
*     Cast3M introduction (Chapter 5), then one elastic solve
      rr = ff - (bsig mo s) - (aa * uu);
      res = maxi (abs (exco rr lfor));
      si (res < (tol * (maxi (abs ff))));
        quitter bequ;
      finsi;
      si (&bequ ega 2000);
        mess 'step ' &bpas ': no convergence, residual ' res;
      finsi;
      uu = uu + (reso (kk et aa) rr);
    fin bequ;
    st . 'U' = uu;
    st . 'SIG' = s;
    st . 'BET' = b;
    st . 'ALP' = a;
    fo = ff;
  fin bpas;
finproc st nit;
*
*----------------------------------------------------------------
* STEP 1  options: axisymmetric (r, z), linear quadrangles
*----------------------------------------------------------------
  opti dime 2 mode axis elem qua4 echo 0;
*
*----------------------------------------------------------------
* STEP 2  slice a <= r <= b, 0 <= z <= h, nr elements in r
*----------------------------------------------------------------
  a = 100.;  b = 200.;  h = 1.;  nr = 200;
  p1 = a 0.;  p2 = b 0.;  p3 = b h;  p4 = a h;
  l12 = droi nr p1 p2;
  l23 = droi 1 p2 p3;
  l34 = droi nr p3 p4;
  l41 = droi 1 p4 p1;
  dom = dall l12 l23 l34 l41;
*
*----------------------------------------------------------------
* STEP 3  elastic model (used by RIGI, SIGM and BSIG), plane
*         strain (UZ = 0 on both faces), unit pressure on the bore
*----------------------------------------------------------------
  you = 200000.;  nu = 0.3;  sy = 250.;
  mo = mode dom mecanique elastique isotrope;
  ma = mate mo 'YOUN' you 'NU' nu;
  kk = rigi mo ma;
  aa = (bloq uz l12) et (bloq uz l34);
  fp = pres 'MASS' mo 1. l41;
*
* radius of the Gauss points, for the size of the plastic zone
  rg = chan 'CHAM' (coor 1 dom) mo 'STRESSES';
*
*----------------------------------------------------------------
* STEP 4  perfect plasticity (K = H = 0), 20 steps up to 0.8 pL
*         and 0.95 pL, pL = (2 sY / sqrt 3) ln(b/a)
*----------------------------------------------------------------
  tm = table;
  tm . 'MU'   = you / (2. * (1. + nu));
  tm . 'H'    = 0.;
  tm . 'SIGY' = sy;
  tm . 'LOI'  = 'LINE';
  tm . 'K'    = 0.;
  tm . 'DIAG' = mots 'SMRR' 'SMZZ' 'SMTT';
  tm . 'OFFD' = mots 'SMRZ';
*
  pl = ((2. * sy) / (3. ** 0.5)) * (log (b / a));
  mess 'limit pressure pL = ' pl '   (200.0944)';
  lfr = prog 0.8 0.95;
  repeter bcas 2;
    fr = extr lfr &bcas;
    lp = (fr * pl / 20.) * (prog 1. pas 1. 20.);
    st nit = incr dom mo ma kk aa fp lp tm 1.e-6;
    ua = extr (st . 'U') 'UR' p1;
    cc = maxi ((masq (st . 'ALP') 'SUPERIEUR' 0.) * rg);
    mess 'p = ' fr ' pL: u(a) = ' ua ' mm, plastic radius '
         cc ' mm, ' nit ' iterations';
  fin bcas;
  mess 'Python (Newton, 200 elements): 0.8 pL: u(a) = 0.18305,'
       ' c = 131.00 (closed form 130.77), 60 iterations';
  mess '                                0.95 pL: u(a) = 0.30536,'
       ' c = 165.50 (closed form 164.00), 70 iterations';
*
*----------------------------------------------------------------
* STEP 5  the same with Voce hardening, p = 320 MPa in 10 steps
*         (Exercise "Consistent against continuum tangent")
*----------------------------------------------------------------
  tm . 'LOI'  = 'VOCE';
  tm . 'SINF' = 600.;
  tm . 'DELT' = 30.;
* (the Python reference uses 80 elements: expect u(a) to differ in
*  the third digit with nr = 200)
  lp = 32. * (prog 1. pas 1. 10.);
  st nit = incr dom mo ma kk aa fp lp tm 1.e-6;
  ua = extr (st . 'U') 'UR' p1;
  mess 'Voce, p = 320 MPa: u(a) = ' ua ' mm, ' nit ' iterations'
       '   (Python, 80 elements: 3.4526 mm; Newton 47 iterations)';
*
*----------------------------------------------------------------
* STEP 6  the reference computation with PASAPAS (perfect
*         plasticity, 0.8 pL): same mesh, built-in return map
*----------------------------------------------------------------
  mop = mode dom mecanique elastique isotrope plastique parfait;
  map = mate mop 'YOUN' you 'NU' nu 'SIGY' sy;
  tab = table;
  tab . 'MODELE' = mop;
  tab . 'CARACTERISTIQUES' = map;
  tab . 'BLOCAGES_MECANIQUES' = aa;
  tab . 'CHARGEMENT' = char 'MECA' fp
        (evol manu 'TEMPS' (prog 0. 20.) 'P' (prog 0. (0.8 * pl)));
  tab . 'TEMPS_CALCULES' = prog 0. pas 1. 20.;
  pasapas tab;
  ua = extr (tab . 'DEPLACEMENTS' . 20) 'UR' p1;
  ep = exco (tab . 'VARIABLES_INTERNES' . 20) 'EPSE' 'SCAL';
  cc = maxi ((masq ep 'SUPERIEUR' 0.) * rg);
  mess 'PASAPAS, 0.8 pL: u(a) = ' ua ' mm, plastic radius ' cc;
*
  opti donn 5;
fin;
